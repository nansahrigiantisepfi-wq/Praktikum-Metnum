# Metode c) Dekomposisi LU (L segitiga bawah diagonal 1, U segitiga atas)
from fractions import Fraction as F

A = [[F(2), F(1), F(-1)],
     [F(4), F(3), F(1)],
     [F(-2), F(1), F(2)]]
b = [F(3), F(9), F(4)]
n = 3


def tampil(M, judul):
    print(judul)
    for r in M:
        print("  [" + "  ".join(f"{float(v):8.3f}" for v in r) + " ]")
    print()


# forward elimination pada A, simpan semua pengali (m) untuk L
U = [r[:] for r in A]
L = [[F(1) if i == j else F(0) for j in range(n)] for i in range(n)]
print("Pengali (m) dari forward elimination:")
for k in range(n - 1):
    for i in range(k + 1, n):
        m = U[i][k] / U[k][k]
        L[i][k] = m
        print(f"  m{i+1}{k+1} = {float(m):g}")
        for j in range(k, n):
            U[i][j] -= m * U[k][j]
print()

tampil(L, "Matriks L:")
tampil(U, "Matriks U:")

# tunjukkan A = LU
LU = [[sum(L[i][k] * U[k][j] for k in range(n)) for j in range(n)] for i in range(n)]
tampil(LU, "Hasil perkalian L x U:")
print("A = LU ?", LU == A, "\n")

# Ly = b (substitusi maju)
y = [F(0)] * n
print("Ly = b (forward substitution):")
for i in range(n):
    y[i] = b[i] - sum(L[i][j] * y[j] for j in range(i))
    print(f"  y{i+1} = {float(y[i]):g}")
print()

# Ux = y (substitusi mundur)
x = [F(0)] * n
print("Ux = y (backward substitution):")
for i in range(n - 1, -1, -1):
    x[i] = (y[i] - sum(U[i][j] * x[j] for j in range(i + 1, n))) / U[i][i]
    print(f"  x{i+1} = {float(x[i]):g}")

print("\nHasil akhir (LU):")
for i in range(n):
    print(f"  x{i+1} = {float(x[i]):g}")