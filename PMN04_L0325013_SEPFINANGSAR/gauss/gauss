# Metode a) Eliminasi Gauss (forward elimination + substitusi mundur)
from fractions import Fraction as F

A = [[F(2), F(1), F(-1)],
     [F(4), F(3), F(1)],
     [F(-2), F(1), F(2)]]
b = [F(3), F(9), F(4)]
n = 3


def tampil(M, judul):
    print(judul)
    for r in M:
        print("  [" + "  ".join(f"{float(v):8.3f}" for v in r) + " ]")
    print()


# matriks augmented [A | b]
M = [A[i][:] + [b[i]] for i in range(n)]
tampil(M, "Matriks augmented [A|b]:")

# forward elimination -> segitiga atas
for k in range(n - 1):
    for i in range(k + 1, n):
        m = M[i][k] / M[k][k]
        print(f"m{i+1}{k+1} = {float(M[i][k]):g}/{float(M[k][k]):g} = {float(m):g}"
              f"  ->  R{i+1} = R{i+1} - ({float(m):g})*R{k+1}")
        for j in range(k, n + 1):
            M[i][j] -= m * M[k][j]
    tampil(M, f"Setelah eliminasi kolom {k+1}:")

# substitusi mundur
x = [F(0)] * n
print("Substitusi mundur:")
for i in range(n - 1, -1, -1):
    s = sum(M[i][j] * x[j] for j in range(i + 1, n))
    x[i] = (M[i][n] - s) / M[i][i]
    print(f"  x{i+1} = {float(x[i]):g}")

print("\nHasil akhir (Gauss):")
for i in range(n):
    print(f"  x{i+1} = {float(x[i]):g}")